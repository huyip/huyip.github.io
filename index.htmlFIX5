<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HUYIP.COM — Giới thiệu</title>
<link rel="icon" type="image/png" href="favicon.png">
<link rel="stylesheet" href="style.css">
<style>
    body {
        padding-bottom: 0 !important;
    }

    #mainWebsite {
        min-height: 100vh;
    }

    .intro-home {
        min-height: 100vh !important;
        display: flex !important;
        align-items: center !important;
        padding-bottom: 70px !important;
    }

    @media (max-width: 700px) {
        .intro-home {
            padding-bottom: 45px !important;
        }
    }
</style>

</head>
<body>
<!-- ===== HUYIP PREMIUM WELCOME ===== -->
<div id="huyipWelcome" class="huyip-welcome" aria-hidden="false">
    <div id="huyipBackgroundFX" aria-hidden="true">
    <div class="huyip-stars" id="huyipStars"></div>

    <div class="huyip-smoke huyip-smoke-1"></div>
    <div class="huyip-smoke huyip-smoke-2"></div>
</div>
    <div class="welcome-aurora welcome-aurora-a"></div>
    <div class="welcome-aurora welcome-aurora-b"></div>
    <div class="welcome-grid"></div>
    <div class="welcome-noise"></div>

    <div class="welcome-shell">
        <div class="welcome-eyebrow">
            <span class="welcome-live-dot"></span>
            SECURE ACCESS PORTAL
        </div>

        <div class="welcome-brand-wrap">
            <div class="welcome-brand-glow"></div>
            <h1 class="welcome-brand">HUYIP<span>.COM</span></h1>
        </div>
        <p class="welcome-kicker">WELCOME / CHÀO MỪNG</p>
        <h2 class="welcome-title">Chọn ngôn ngữ của bạn</h2>
        <p class="welcome-subtitle">
            Select your preferred language to continue
        </p>

        <div class="welcome-languages" role="list">
            <button class="welcome-lang" type="button" data-lang="vi" data-label="Tiếng Việt">
                <span class="welcome-lang-code">VI</span>
                <span class="welcome-lang-copy">
                    <strong>Tiếng Việt</strong>
                    <small>Vietnamese</small>
                </span>
                <span class="welcome-lang-check">✓</span>
            </button>

            <button class="welcome-lang" type="button" data-lang="en" data-label="English">
                <span class="welcome-lang-code">EN</span>
                <span class="welcome-lang-copy">
                    <strong>English</strong>
                    <small>International</small>
                </span>
                <span class="welcome-lang-check">✓</span>
            </button>

            <button class="welcome-lang" type="button" data-lang="zh" data-label="中文">
                <span class="welcome-lang-code">中</span>
                <span class="welcome-lang-copy">
                    <strong>中文</strong>
                    <small>Chinese</small>
                </span>
                <span class="welcome-lang-check">✓</span>
            </button>

            <button class="welcome-lang" type="button" data-lang="th" data-label="ภาษาไทย">
                <span class="welcome-lang-code">TH</span>
                <span class="welcome-lang-copy">
                    <strong>ภาษาไทย</strong>
                    <small>Thai</small>
                </span>
                <span class="welcome-lang-check">✓</span>
            </button>
        </div>

        <button id="welcomeContinue" class="welcome-continue" type="button" disabled>
            <span>CHỌN NGÔN NGỮ ĐỂ TIẾP TỤC</span>
            <b>→</b>
        </button>

        <div class="welcome-footer">
            <span><i></i> Encrypted session</span>
            <span>HUYIP SYSTEM • 2026</span>
        </div>
    </div>
</div>

<button id="welcomeLanguageSwitch" class="welcome-language-switch" type="button"
        aria-label="Đổi ngôn ngữ" title="Đổi ngôn ngữ">
    <span>🌐</span>
    <b id="welcomeCurrentLang">VI</b>
</button>
<!-- ===== END HUYIP PREMIUM WELCOME ===== -->
<div id="particles"></div>
<main id="mainWebsite">
    <section class="intro-home" id="introHome">

    <div class="intro-home-glow"></div>

    <div class="intro-home-inner">

        <div class="intro-badge">
            <span></span>
            HUYIP SYSTEM
        </div>

        <h1>
            Hệ thống kiểm tra và
            <span>bảo vệ tài khoản</span>
        </h1>

        <p class="intro-desc">
            Nền tảng hỗ trợ kiểm tra trạng thái tài khoản,
            phân tích dữ liệu và quản lý quy trình xử lý
            trong một giao diện duy nhất.
        </p>

        <div class="intro-actions">

            <a href="system.html" class="intro-main-btn">
                BẮT ĐẦU SỬ DỤNG HỆ THỐNG
                <b>→</b>
            </a>

            <a href="system.html#process" class="intro-second-btn">
                XEM QUY TRÌNH
            </a>

        </div>


        <div class="intro-stats">

            <div class="intro-stat">
                <div class="stat-icon">◎</div>
                <strong>24/7</strong>
                <span>Hệ thống hoạt động</span>
            </div>

            <div class="intro-stat">
                <div class="stat-icon">◇</div>
                <strong>SECURE</strong>
                <span>Kết nối bảo mật</span>
            </div>

            <div class="intro-stat">
                <div class="stat-icon">⚡</div>
                <strong>REAL-TIME</strong>
                <span>Xử lý trạng thái tức thời</span>
            </div>

            <div class="intro-stat">
                <div class="stat-icon">✓</div>
                <strong>AUTO</strong>
                <span>Quy trình tự động hóa</span>
            </div>

        </div>


        <div class="intro-features">

            <article class="intro-feature">

                <div class="feature-no">01</div>

                <div class="feature-symbol">⌁</div>

                <h3>Kiểm tra hệ thống</h3>

                <p>
                    Theo dõi trạng thái và các thông tin
                    cần thiết trước khi thực hiện xử lý.
                </p>

            </article>


            <article class="intro-feature">

                <div class="feature-no">02</div>

                <div class="feature-symbol">◎</div>

                <h3>Phân tích dữ liệu</h3>

                <p>
                    Tổng hợp dữ liệu trong một giao diện
                    trực quan và dễ theo dõi.
                </p>

            </article>


            <article class="intro-feature">

                <div class="feature-no">03</div>

                <div class="feature-symbol">▣</div>

                <h3>Nhận kết quả</h3>

                <p>
                    Hiển thị kết quả xử lý và trạng thái
                    hệ thống theo từng bước.
                </p>

            </article>

        </div>


        <div class="intro-bottom">

            <div>
                <span class="intro-live-dot"></span>
                SYSTEM ONLINE
            </div>

            <span>
                HUYIP.COM • SYSTEM 2026
            </span>

        </div>

    </div>

    </section>
</main>

<script>
(() => {
    const welcome = document.getElementById("huyipWelcome");
    const continueButton = document.getElementById("welcomeContinue");
    const languageSwitcher = document.getElementById("welcomeLanguageSwitch");
    const currentLanguage = document.getElementById("welcomeCurrentLang");
    const languageButtons = [...document.querySelectorAll(".welcome-lang")];

    if (!welcome || !continueButton || !languageSwitcher || !currentLanguage) {
        return;
    }

    const labels = {
        vi: "TIẾP TỤC VỚI TIẾNG VIỆT",
        en: "CONTINUE IN ENGLISH",
        zh: "继续使用中文",
        th: "ดำเนินการต่อ"
    };

    let selectedLanguage = localStorage.getItem("huyip_language") || null;

    function selectLanguage(language) {
        selectedLanguage = language;

        languageButtons.forEach((button) => {
            button.classList.toggle(
                "selected",
                button.dataset.lang === language
            );
        });

        continueButton.disabled = false;

        const label = continueButton.querySelector("span");
        if (label) {
            label.textContent = labels[language] || labels.vi;
        }
    }

    function openWelcome() {
        welcome.style.display = "flex";
        welcome.classList.remove("leaving");
        welcome.classList.add("show");
        welcome.setAttribute("aria-hidden", "false");
        document.body.classList.add("welcome-open");

        if (selectedLanguage) {
            selectLanguage(selectedLanguage);
        }
    }

    function closeWelcome() {
        if (!selectedLanguage) return;

        localStorage.setItem("huyip_language", selectedLanguage);
        document.documentElement.lang = selectedLanguage;
        currentLanguage.textContent = selectedLanguage.toUpperCase();

        welcome.classList.add("leaving");
        document.body.classList.remove("welcome-open");

        window.setTimeout(() => {
            welcome.classList.remove("show", "leaving");
            welcome.setAttribute("aria-hidden", "true");
            welcome.style.display = "none";
        }, 300);
    }

    languageButtons.forEach((button) => {
        button.addEventListener("click", () => {
            selectLanguage(button.dataset.lang);
        });
    });

    continueButton.addEventListener("click", closeWelcome);
    languageSwitcher.addEventListener("click", openWelcome);

    /*
       Luôn hiện màn chọn ngôn ngữ khi người dùng vào index.html.
       Nếu trước đó đã chọn ngôn ngữ, chỉ highlight lựa chọn cũ.
    */
    if (selectedLanguage) {
        document.documentElement.lang = selectedLanguage;
        currentLanguage.textContent = selectedLanguage.toUpperCase();
        selectLanguage(selectedLanguage);
    }

    openWelcome();
})();
</script>
</body>
</html>